+            Ok(shown(&adj, "Settings copied.".into()))
+        }
+        "paste" => {
+            let path = image(1)?;
+            let adj = photo::pasted_settings().ok_or_else(|| anyhow!("nothing copied yet"))?;
+            let abs = std::fs::canonicalize(path)?.to_string_lossy().into_owned();
+            photo::save_settings(&abs, &adj)?;
