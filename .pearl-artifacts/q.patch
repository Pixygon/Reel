+            .collect();
+        for (b, (name, _)) in BANDS.iter().enumerate() {
+            let mut a = Adjust::default();
+            a.hsl[b] = Band { hue: 40.0, sat: -50.0, lum: 30.0 };
+            all.push((format!("hsl-{name}"), a));
+        }
+        let mut a = Adjust::default();
+        a.curve.master = [0.05, 0.2, 0.5, 0.8, 0.95];
+        all.push(("curve".into(), a));
+        all
+    }
