+            let abs = std::fs::canonicalize(path)?.to_string_lossy().into_owned();
+            photo::save_settings(&abs, &adj)?;
+            Ok(shown(&adj, format!("Saved settings to {}", photo::sidecar(&abs))))
+        }
+        "copy" => {
+            let adj = photo_settings(p, image(1)?)?;
