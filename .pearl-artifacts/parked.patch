+    #[test]
+    fn rotation_inverse_lands_on_the_source_corner() {
+        // The top-left of a 90° clockwise frame is the source's bottom-left.
+        assert_eq!(unrotate_uv([0.0, 0.0], 1), [0.0, 1.0]);
