+        fx.zoom = 2.0;
+        assert_eq!(view_to_source([0.0, 0.0], Some(&fx), 0), [0.25, 0.25]);
+        fx.flip_h = true;
+        assert_eq!(view_to_source([0.0, 0.0], Some(&fx), 0), [0.75, 0.25]);
+    }
