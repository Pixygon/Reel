+/// One local adjustment, resolved on this device.
+pub struct LocalPass {
+    pub matte: MatteBind,
+    pub effects: crate::effects::Effects,
+    pub lut: Option<wgpu::TextureView>,
+    pub plugin: Option<std::sync::Arc<crate::plugins::Plugin>>,
